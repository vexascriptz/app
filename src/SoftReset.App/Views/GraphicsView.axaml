<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             xmlns:app="using:SoftReset.App"
             xmlns:p="using:SoftReset.Core.Platform"
             x:Class="SoftReset.App.Views.GraphicsView" x:DataType="vm:GraphicsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="GpuSettingTemplate" x:DataType="vm:GpuSettingRow">
      <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
        <Grid ColumnDefinitions="*,24,280">
          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{Binding Category, Converter={x:Static app:Converters.Upper}}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap" />
            <TextBlock Classes="body" Text="{Binding Knowledge.Description}" />
            <TextBlock Classes="body" Text="{Binding Knowledge.Effects}" IsVisible="{Binding Knowledge.Effects, Converter={x:Static app:Converters.NotEmpty}}" />
            <TextBlock Classes="label" Text="TRADE-OFFS" Margin="0,4,0,0" IsVisible="{Binding Knowledge.Tradeoffs, Converter={x:Static app:Converters.NotEmpty}}" />
            <TextBlock Classes="body" Text="{Binding Knowledge.Tradeoffs}" IsVisible="{Binding Knowledge.Tradeoffs, Converter={x:Static app:Converters.NotEmpty}}" />
            <TextBlock Classes="label" Text="RECOMMENDED" Margin="0,4,0,0" IsVisible="{Binding RecommendationText, Converter={x:Static app:Converters.NotEmpty}}" />
            <TextBlock Classes="body" Text="{Binding RecommendationText}" IsVisible="{Binding RecommendationText, Converter={x:Static app:Converters.NotEmpty}}" />
            <TextBlock Classes="muted small wrap" Text="{Binding Knowledge.Notes}" IsVisible="{Binding Knowledge.Notes, Converter={x:Static app:Converters.NotEmpty}}" />
          </StackPanel>
          <Border Grid.Column="2" Classes="soft" VerticalAlignment="Top">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="CURRENT VALUE" />
              <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Text="{Binding Location}" IsVisible="{Binding Location, Converter={x:Static app:Converters.NotNull}}" />
              <TextBlock Classes="label" Text="WHERE TO CHANGE IT" Margin="0,8,0,0" />
              <TextBlock Classes="small wrap" Text="{Binding Knowledge.WhereToChange}" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="32,4,32,24">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
      <Button Classes="secondary small" Content="Refresh" Command="{Binding RefreshCommand}" />
      <Button Classes="secondary small" Content="Windows graphics settings" Command="{Binding OpenWindowsGraphicsCommand}" />
      <Button Classes="secondary small" Content="DirectX Diagnostic Tool" Command="{Binding OpenDxDiagCommand}" />
      <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding Loading}" VerticalAlignment="Center" />
    </StackPanel>

    <TabControl x:Name="GraphicsTabs">
      <TabItem Header="Overview">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Gpus}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GpuCard">
                  <Border Classes="card" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,24,*">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding VendorText}" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                          <TextBlock Classes="label" Text="DRIVER" />
                          <TextBlock Grid.Column="1" Classes="body" Text="{Binding Driver}" />
                          <TextBlock Grid.Row="1" Classes="label" Text="DEDICATED MEMORY" Margin="0,6,0,0" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding Memory}" Margin="0,6,0,0" />
                        </Grid>
                        <TextBlock Classes="muted small wrap" Text="{Binding Source}" Margin="0,6,0,0" />
                        <TextBlock Classes="small wrap" Foreground="{StaticResource WarningBrush}" Text="{Binding Throttle}" IsVisible="{Binding Throttle, Converter={x:Static app:Converters.NotEmpty}}" />
                      </StackPanel>
                      <UniformGrid Grid.Column="2" Columns="3" IsVisible="{Binding HasTelemetry}">
                        <Border Classes="soft" Margin="0,0,8,8"><StackPanel><TextBlock Classes="label" Text="TEMPERATURE" /><TextBlock Classes="h3" Text="{Binding Temperature}" /></StackPanel></Border>
                        <Border Classes="soft" Margin="0,0,8,8"><StackPanel><TextBlock Classes="label" Text="LOAD" /><TextBlock Classes="h3" Text="{Binding Utilization}" /></StackPanel></Border>
                        <Border Classes="soft" Margin="0,0,0,8"><StackPanel><TextBlock Classes="label" Text="FAN" /><TextBlock Classes="h3" Text="{Binding Fan}" /></StackPanel></Border>
                        <Border Classes="soft" Margin="0,0,8,0"><StackPanel><TextBlock Classes="label" Text="POWER" /><TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Power}" /></StackPanel></Border>
                        <Border Classes="soft" Margin="0,0,8,0"><StackPanel><TextBlock Classes="label" Text="VIDEO MEMORY" /><TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Vram}" /></StackPanel></Border>
                        <Border Classes="soft"><StackPanel><TextBlock Classes="label" Text="STATE" /><TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Extra}" /></StackPanel></Border>
                      </UniformGrid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Displays" />
                <ItemsControl ItemsSource="{Binding Displays}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DisplayRow">
                      <Border Classes="soft" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                            <TextBlock Classes="body" Text="{Binding Mode}" />
                            <TextBlock Classes="muted small" Text="{Binding Max}" />
                            <TextBlock Classes="muted small" Text="{Binding Adapter}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="primary small" VerticalAlignment="Center" IsVisible="{Binding CanIncrease}"
                                  Content="{Binding Display.MaxRefreshHzAtCurrentResolution, StringFormat='Use {0} Hz…'}"
                                  Command="{Binding $parent[UserControl].((vm:GraphicsViewModel)DataContext).SetMaxRefreshCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted small wrap" Text="Refresh-rate changes are tested by Windows first, then applied with a 15-second keep-or-revert countdown. Only modes the driver reports for the current resolution are offered." />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Windows graphics options" />
                <TextBlock Classes="body" Text="These are Windows settings rather than driver settings, so the console can inspect, change, and roll them back through the Optimization workflow." />
                <WrapPanel>
                  <Button Classes="secondary" Content="Hardware-accelerated GPU scheduling" Command="{Binding HagsCommand}" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="Per-app GPU preference" Command="{Binding GpuPreferenceCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="NVIDIA" IsVisible="{Binding HasNvidia}">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <Border Classes="hero">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h3" Text="NVIDIA driver settings" />
                  <TextBlock Classes="body" Text="{Binding NvidiaStatus}" />
                  <TextBlock Classes="muted small wrap" Text="Values are read from the driver's own settings database through NVIDIA's public NVAPI interface, in a separate process. The console never writes driver settings — use the NVIDIA Control Panel or NVIDIA App to change them." />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                  <Button Classes="primary" Content="Read driver settings" Command="{Binding ReadNvidiaSettingsCommand}" x:Name="ReadNvidiaButton" />
                  <Button Classes="secondary" Content="NVIDIA Control Panel" Command="{Binding OpenVendorCommand}" CommandParameter="nvcp" />
                  <Button Classes="secondary" Content="NVIDIA App" Command="{Binding OpenVendorCommand}" CommandParameter="nvapp" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="card" IsVisible="{Binding Profiles.Count}">
              <StackPanel Spacing="8">
                <TextBlock Classes="h3" Text="Per-game profiles changed from the driver defaults" />
                <ItemsControl ItemsSource="{Binding Profiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="p:NvidiaProfileSummary">
                      <Border Classes="soft" Margin="0,0,0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" />
                          <TextBlock Classes="muted small">
                            <Run Text="{Binding UserModifiedSettingCount, Mode=OneWay}" /><Run Text=" user-changed setting(s) · " /><Run Text="{Binding ApplicationCount, Mode=OneWay}" /><Run Text=" program(s)" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding NvidiaSettings}" ItemTemplate="{StaticResource GpuSettingTemplate}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="AMD" IsVisible="{Binding HasAmd}">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <Border Classes="hero">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h3" Text="AMD Software: Adrenalin Edition" />
                  <TextBlock Classes="body" Text="AMD does not offer a public interface for reading these settings, so the console explains them and opens AMD Software to change them." />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Content="Open AMD Software" Command="{Binding OpenVendorCommand}" CommandParameter="amd" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding AmdSettings}" ItemTemplate="{StaticResource GpuSettingTemplate}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Intel" IsVisible="{Binding HasIntel}">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="0,12,0,0">
            <Border Classes="hero">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h3" Text="Intel Graphics Software" />
                  <TextBlock Classes="body" Text="Intel graphics settings are explained here and changed in Intel's own software." />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Content="Open Intel software" Command="{Binding OpenVendorCommand}" CommandParameter="intel" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding IntelSettings}" ItemTemplate="{StaticResource GpuSettingTemplate}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
