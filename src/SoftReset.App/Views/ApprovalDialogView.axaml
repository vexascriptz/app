<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             xmlns:opt="using:SoftReset.Core.Optimization"
             xmlns:app="using:SoftReset.App"
             x:Class="SoftReset.App.Views.ApprovalDialogView" x:DataType="vm:ApprovalDialogViewModel">
  <DockPanel Width="620" MaxHeight="720">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
      <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
      <WrapPanel>
        <Border Classes="pill" Margin="0,0,6,0" Background="{StaticResource SuccessBgBrush}" IsVisible="{Binding !IsIrreversible}">
          <TextBlock Text="{Binding ReversibilityText}" Foreground="{StaticResource SuccessBrush}" />
        </Border>
        <Border Classes="pill" Margin="0,0,6,0" Background="{StaticResource DangerBgBrush}" IsVisible="{Binding IsIrreversible}">
          <TextBlock Text="{Binding ReversibilityText}" Foreground="{StaticResource DangerBrush}" />
        </Border>
        <Border Classes="pill" Margin="0,0,6,0" IsVisible="{Binding HasAdminText}"><TextBlock Text="{Binding AdminText}" /></Border>
        <Border Classes="pill" Margin="0,0,6,0" Background="{StaticResource WarningBgBrush}" IsVisible="{Binding RequiresRestart}"><TextBlock Text="Needs a restart" Foreground="{StaticResource WarningBrush}" /></Border>
      </WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,16,0,0">
      <CheckBox IsChecked="{Binding CustomerApproved}" x:Name="ApproveCheck" Content="Yes, make this change" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button Classes="secondary" Content="Cancel" Command="{Binding CancelCommand}" x:Name="CancelButton" />
        <Button Classes="primary" Content="Apply" Command="{Binding ApproveCommand}" x:Name="ApplyButton" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="14">
        <Border Classes="soft">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="WHAT WILL CHANGE" />
            <TextBlock Classes="muted" Text="Nothing — it's already set." IsVisible="{Binding !Changes.Count}" />
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="opt:PreviewChange">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Target}" TextWrapping="Wrap" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <Border Classes="pill" Background="{StaticResource InfoBgBrush}"><TextBlock Text="{Binding From}" MaxWidth="170" TextTrimming="CharacterEllipsis" /></Border>
                      <TextBlock Text="→" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                      <Border Classes="pill"><TextBlock Text="{Binding To}" MaxWidth="190" TextTrimming="CharacterEllipsis" /></Border>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted small" Text="{Binding FreedText}" IsVisible="{Binding FreedText, Converter={x:Static app:Converters.NotNull}}" />
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,*">
          <StackPanel Spacing="4" Margin="0,0,10,0">
            <TextBlock Classes="label" Text="WHY" />
            <TextBlock Classes="body" Text="{Binding ExpectedBenefit}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
            <TextBlock Classes="label" Text="WATCH OUT FOR" />
            <TextBlock Classes="body" Text="{Binding Risks}" />
          </StackPanel>
        </Grid>
        <Border Classes="notice" IsVisible="{Binding HasWarnings}">
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="body" Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource WarningBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
