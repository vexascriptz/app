<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             xmlns:app="using:SoftReset.App"
             x:Class="SoftReset.App.Views.ProcessesView" x:DataType="vm:ProcessesViewModel">
  <Grid ColumnDefinitions="*,380" Margin="32,4,32,24">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
        <TextBox Text="{Binding Search}" Watermark="Search" x:Name="SearchBox" />
        <CheckBox Grid.Column="1" Margin="14,0,0,0" IsChecked="{Binding HideWindows}" Content="Hide Windows parts" />
        <CheckBox Grid.Column="2" Margin="14,0,0,0" IsChecked="{Binding AutoRefresh}" Content="Auto-refresh" />
        <Button Grid.Column="3" Classes="secondary small" Margin="10,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Text="{Binding Summary}" Margin="2,8,0,0" />
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                AutoGenerateColumns="False" HeadersVisibility="Column" x:Name="ProcessGrid">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" x:DataType="vm:ProcessRow" />
          <DataGridTextColumn Header="What it is" Binding="{Binding Description}" Width="*" x:DataType="vm:ProcessRow" />
          <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" Width="80" x:DataType="vm:ProcessRow" />
          <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="96" x:DataType="vm:ProcessRow" />
          <DataGridTextColumn Header="Made by" Binding="{Binding Publisher}" Width="170" x:DataType="vm:ProcessRow" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <ScrollViewer Grid.Column="1" Margin="20,0,0,0">
      <StackPanel Spacing="14">
        <Border Classes="card" IsVisible="{Binding Selected, Converter={x:Static app:Converters.IsNull}}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Click a program" />
            <TextBlock Classes="body" Text="You'll see what it is and whether it's safe." />
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding Selected, Converter={x:Static app:Converters.NotNull}}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding Selected.Name, FallbackValue=''}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Knowledge.DisplayName, FallbackValue=''}" IsVisible="{Binding HasKnowledge}" />
            <TextBlock Classes="body" Text="{Binding Knowledge.Description, FallbackValue=''}" IsVisible="{Binding HasKnowledge}" />
            <TextBlock Classes="body" Text="Not a program we recognise. Check who made it below, or search the web." IsVisible="{Binding NoKnowledge}" />
            <Border Classes="soft">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="MADE BY" />
                <TextBlock Classes="body" Text="{Binding SignerText}" />
                <TextBlock Classes="label" Text="LOCATION" Margin="0,6,0,0" />
                <TextBlock Classes="body" Text="{Binding Selected.Path, FallbackValue='Not accessible'}" />
                <TextBlock Classes="muted small wrap" Text="{Binding LocationCheck}" />
                <TextBlock Classes="label" Text="HOSTED SERVICES" Margin="0,6,0,0" IsVisible="{Binding HostedServices, Converter={x:Static app:Converters.NotEmpty}}" />
                <TextBlock Classes="body" Text="{Binding HostedServices}" IsVisible="{Binding HostedServices, Converter={x:Static app:Converters.NotEmpty}}" />
                <TextBlock Classes="label" Text="STARTUP" Margin="0,6,0,0" IsVisible="{Binding Selected.Startup, Converter={x:Static app:Converters.NotEmpty}, FallbackValue=False}" />
                <TextBlock Classes="body" Text="{Binding Selected.Startup, FallbackValue=''}" />
              </StackPanel>
            </Border>
            <Border Classes="notice" IsVisible="{Binding HasIndicators}">
              <StackPanel Spacing="4">
                <TextBlock Classes="label wrap" Text="WORTH A CLOSER LOOK" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Indicators}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Classes="body" Text="{Binding StringFormat='• {0}'}" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Spacing="4" IsVisible="{Binding HasKnowledge}">
              <TextBlock Classes="label" Text="WHAT IT DOES" />
              <TextBlock Classes="body" Text="{Binding Knowledge.Functionality, FallbackValue=''}" />
              <TextBlock Classes="label" Text="IF IT USES A LOT OF CPU" Margin="0,6,0,0" IsVisible="{Binding Knowledge.HighCpu, Converter={x:Static app:Converters.NotEmpty}, FallbackValue=False}" />
              <TextBlock Classes="body" Text="{Binding Knowledge.HighCpu, FallbackValue=''}" />
              <TextBlock Classes="label" Text="IF IT USES A LOT OF MEMORY" Margin="0,6,0,0" IsVisible="{Binding Knowledge.HighMemory, Converter={x:Static app:Converters.NotEmpty}, FallbackValue=False}" />
              <TextBlock Classes="body" Text="{Binding Knowledge.HighMemory, FallbackValue=''}" />
              <TextBlock Classes="label" Text="AT STARTUP" Margin="0,6,0,0" IsVisible="{Binding Knowledge.Startup, Converter={x:Static app:Converters.NotEmpty}, FallbackValue=False}" />
              <TextBlock Classes="body" Text="{Binding Knowledge.Startup, FallbackValue=''}" />
              <TextBlock Classes="label" Text="IF IT CAUSES PROBLEMS" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding Knowledge.Troubleshooting, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><TextBlock Classes="body" Text="{Binding StringFormat='• {0}'}" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Classes="soft" IsVisible="{Binding IsProtected}">
              <TextBlock Classes="body" Text="Part of Windows — can't be ended here." />
            </Border>
            <WrapPanel>
              <Button Classes="danger small" Content="End process" Command="{Binding EndProcessCommand}" IsVisible="{Binding !IsProtected}" Margin="0,0,8,8" />
              <Button Classes="secondary small" Content="Show file" Command="{Binding OpenLocationCommand}" Margin="0,0,8,8" />
              <Button Classes="secondary small" Content="Search web" Command="{Binding SearchOnlineCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="More tools" />
            <WrapPanel>
              <Button Classes="secondary small" Content="Process Explorer" Command="{Binding LaunchSysinternalsCommand}" CommandParameter="procexp" Margin="0,0,8,8" />
              <Button Classes="secondary small" Content="Autoruns" Command="{Binding LaunchSysinternalsCommand}" CommandParameter="autoruns" Margin="0,0,8,8" />
              <Button Classes="secondary small" Content="TCPView" Command="{Binding LaunchSysinternalsCommand}" CommandParameter="tcpview" Margin="0,0,8,8" />
              <Button Classes="secondary small" Content="Task Manager" Command="{Binding OpenTaskManagerCommand}" Margin="0,0,8,8" />
              <Button Classes="secondary small" Content="Resource Monitor" Command="{Binding OpenResourceMonitorCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
