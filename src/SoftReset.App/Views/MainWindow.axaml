<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SoftReset.App.ViewModels"
        xmlns:app="using:SoftReset.App"
        x:Class="SoftReset.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="softreset Technician Console"
        Icon="avares://SoftResetConsole/Assets/softreset.ico"
        Width="1380" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid ColumnDefinitions="252,*">
      <!-- Sidebar -->
      <Border Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,20,16,16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,22">
            <Image Source="avares://SoftResetConsole/Assets/softreset.png" Width="42" Height="42" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="softreset" FontSize="21" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
              <TextBlock Text="Technician Console" Classes="muted small" Margin="1,-2,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <Border Classes="soft" Padding="12">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource IconAdmin}" Width="15" Height="15" />
                  <TextBlock Text="{Binding ElevationText}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" FontSize="12.5" />
                </StackPanel>
                <TextBlock Text="{Binding MachineText}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                <Button Classes="secondary small" Content="Restart as administrator" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding RestartAsAdminCommand}" IsVisible="{Binding !IsElevated}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" x:Name="Nav">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="icon" Data="{Binding Icon}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource NavySoftBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Content -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" Padding="32,22,32,14" Background="White">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="h1" Text="{Binding CurrentPage.Title}" />
              <TextBlock Classes="muted" Text="{Binding CurrentPage.Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Border Classes="pill" Background="{StaticResource WarningBgBrush}" IsVisible="{Binding DemoMode}">
                <TextBlock Text="DEMO MODE — simulated PC, no real changes" Foreground="{StaticResource WarningBrush}" />
              </Border>
              <Border Classes="pill" IsVisible="{Binding SessionBanner, Converter={x:Static app:Converters.NotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
                  <TextBlock Text="{Binding SessionBanner}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
        <ContentControl Content="{Binding CurrentPage}" Margin="0" />
      </DockPanel>
    </Grid>

    <!-- Busy overlay -->
    <Border Background="#66FFFFFF" IsVisible="{Binding IsBusy}">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,20" BoxShadow="{StaticResource RaisedShadow}">
        <StackPanel Spacing="12" Width="320">
          <TextBlock Text="{Binding BusyText}" Classes="h3" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Dialog overlay -->
    <Border Background="#800B2545" IsVisible="{Binding CurrentDialog, Converter={x:Static app:Converters.NotNull}}">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760" MinWidth="460" Padding="28,24"
              BoxShadow="{StaticResource RaisedShadow}" CornerRadius="20">
        <ContentControl Content="{Binding CurrentDialog}" />
      </Border>
    </Border>

    <!-- Toasts -->
    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22" Width="420">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastItem">
          <Border Classes="card" Padding="14,11" Margin="0,8,0,0" BoxShadow="{StaticResource RaisedShadow}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,10,0" Fill="{StaticResource AccentBrush}" Classes.success="{Binding Kind, Converter={x:Static app:Converters.ToastIsSuccess}}" Classes.warning="{Binding Kind, Converter={x:Static app:Converters.ToastIsWarning}}" />
              <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
              <Button Grid.Column="2" Classes="ghost small" Content="✕" Padding="6,0" Margin="8,0,0,0"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>

  <Window.Styles>
    <Style Selector="Ellipse.success">
      <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.warning">
      <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
    </Style>
  </Window.Styles>
</Window>
