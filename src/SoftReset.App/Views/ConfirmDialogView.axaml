<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             x:Class="SoftReset.App.Views.ConfirmDialogView" x:DataType="vm:ConfirmDialogViewModel">
  <StackPanel Spacing="16">
    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Classes="body" Text="{Binding Message}" />
    <StackPanel Spacing="6" IsVisible="{Binding HasTypedRequirement}">
      <TextBlock Classes="muted">
        <Run Text="Type" /> <Run Text="{Binding RequireTypedText, Mode=OneWay}" FontWeight="Bold" /> <Run Text="to confirm." />
      </TextBlock>
      <TextBox Text="{Binding TypedText}" x:Name="TypedBox" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Classes="secondary" Content="{Binding CancelText}" Command="{Binding CancelCommand}" x:Name="CancelButton" />
      <Button Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" x:Name="ConfirmButton"
              Classes.danger="{Binding Danger}" />
    </StackPanel>
  </StackPanel>
</UserControl>
