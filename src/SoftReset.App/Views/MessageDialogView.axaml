<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             x:Class="SoftReset.App.Views.MessageDialogView" x:DataType="vm:MessageDialogViewModel">
  <StackPanel Spacing="16">
    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
    <ScrollViewer MaxHeight="420"><TextBlock Classes="body" Text="{Binding Message}" /></ScrollViewer>
    <Button Classes="primary" Content="OK" Command="{Binding OkCommand}" HorizontalAlignment="Right" x:Name="OkButton" />
  </StackPanel>
</UserControl>
