<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             xmlns:app="using:SoftReset.App"
             x:Class="SoftReset.App.Views.OptimizationView" x:DataType="vm:OptimizationViewModel">
  <UserControl.Styles>
    <Style Selector="Button.ghost.selected">
      <Setter Property="Background" Value="{StaticResource SkyLightBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="32,4,32,24">
  <Border DockPanel.Dock="Top" Classes="hero" Padding="20,14" Margin="0,0,0,16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="h3" Text="Do it all for me" />
        <TextBlock Classes="muted small" Text="Applies every safe fix this PC needs. You can undo it." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Classes="secondary" Content="Undo" Command="{Binding UndoAutoCommand}" IsVisible="{Binding CanUndoAuto}" />
        <Button Classes="primary" Command="{Binding AutoOptimizeCommand}" x:Name="OptimizationAutoButton">
          <StackPanel Orientation="Horizontal" Spacing="8"><Path Classes="icon" Data="{StaticResource IconWand}" Stroke="White" Width="15" Height="15" /><TextBlock Text="Auto optimize" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
  <Grid ColumnDefinitions="360,*">
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Groups}" x:Name="ActionGroups">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryGroup">
            <StackPanel Spacing="6" Margin="0,0,10,18">
              <TextBlock Classes="label" Text="{Binding Name, Converter={x:Static app:Converters.Upper}}" />
              <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActionCard">
                    <Button Classes="ghost" Classes.selected="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,2"
                            Command="{Binding $parent[UserControl].((vm:OptimizationViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Badges}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
      <StackPanel Spacing="14">
        <Border Classes="soft" Padding="30" IsVisible="{Binding !HasSelection}">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IconWand}" Width="36" Height="36" HorizontalAlignment="Center" />
            <TextBlock Classes="h3" Text="Pick a fix on the left" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="You'll see what it changes before anything happens." HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="{Binding Selected.Title, FallbackValue=''}" TextWrapping="Wrap" />
              <TextBlock Classes="body" Text="{Binding Selected.Description, FallbackValue=''}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Inspecting}" />
            <Border Classes="soft">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="RIGHT NOW" />
                <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding StateText}" x:Name="StateText" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding HasOptions}">
              <TextBlock Classes="label" Text="CHOOSE" />
              <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem">
                    <RadioButton GroupName="ActionOptions" IsChecked="{Binding IsSelected}" Margin="0,1"
                                 Command="{Binding $parent[UserControl].((vm:OptimizationViewModel)DataContext).ChooseOptionCommand}" CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="520" />
                        <TextBlock Classes="muted small" Text="{Binding Hint}" VerticalAlignment="Center" />
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasItems}">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="label" Text="TICK THE ONES TO CHANGE" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost small" Content="All" Command="{Binding SelectAllItemsCommand}" />
                <Button Grid.Column="2" Classes="ghost small" Content="None" Command="{Binding SelectNoItemsCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Items}" x:Name="ActionItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SelectableItem">
                    <Border Classes="soft" Margin="0,0,0,6" Padding="10,8">
                      <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Selectable}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap" />
                          <TextBlock Classes="small wrap" Text="{Binding Recommendation}" IsVisible="{Binding Recommendation, Converter={x:Static app:Converters.NotEmpty}}" Foreground="{StaticResource MutedBrush}" />
                          <TextBlock Classes="small wrap" Text="{Binding Warning}" IsVisible="{Binding Warning, Converter={x:Static app:Converters.NotEmpty}}" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="Review and apply…" Command="{Binding ApplyCommand}" IsEnabled="{Binding Applicable}" x:Name="ApplyActionButton" />
              <Button Classes="secondary" Content="Undo" Command="{Binding RollbackLastCommand}" IsVisible="{Binding CanRollbackLast}" x:Name="RollbackLastButton" />
              <Border Classes="pill" VerticalAlignment="Center"><TextBlock Text="{Binding Selected.Badges, FallbackValue=''}" /></Border>
            </StackPanel>

            <Expander Header="Why and what to watch out for" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,20,*">
                <StackPanel Spacing="3">
                  <TextBlock Classes="label" Text="WHY" />
                  <TextBlock Classes="body" Text="{Binding Selected.Action.ExpectedBenefit, FallbackValue=''}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Classes="label" Text="WATCH OUT FOR" />
                  <TextBlock Classes="body" Text="{Binding Selected.Action.Risks, FallbackValue=''}" />
                </StackPanel>
              </Grid>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </DockPanel>
</UserControl>
