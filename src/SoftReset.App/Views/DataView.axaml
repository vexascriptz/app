<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftReset.App.ViewModels"
             x:Class="SoftReset.App.Views.DataView" x:DataType="vm:DataViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,4,32,32" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*">
          <Image Source="avares://SoftResetConsole/Assets/softreset.png" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Classes="h2" Text="softreset Technician Console" />
            <TextBlock Classes="muted" Text="{Binding Version, StringFormat='Version {0}'}" />
            <TextBlock Classes="muted small" Text="{Binding PlatformText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="Saved data" />
          <TextBlock Classes="body" Text="{Binding DataRoot}" />
          <TextBlock Classes="muted" Text="{Binding DataSize, StringFormat='Size: {0}'}" x:Name="DataSizeText" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="secondary" Content="Open folder" Command="{Binding OpenDataFolderCommand}" />
            <Button Classes="secondary" Content="Open reports" Command="{Binding OpenReportsFolderCommand}" />
            <Button Classes="danger" Content="Delete all saved data…" Command="{Binding RemoveAllDataCommand}" x:Name="RemoveDataButton" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="Scan length" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox ItemsSource="{Binding SampleOptions}" SelectedItem="{Binding SampleSeconds}" Width="140">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:Int32"><TextBlock Text="{Binding StringFormat='{}{0} seconds'}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="primary" Content="Save" Command="{Binding SaveSettingsCommand}" x:Name="SaveSettingsButton" />
          </StackPanel>
          <TextBlock Classes="muted small" Text="Longer scans measure CPU use more accurately." />
        </StackPanel>
      </Border>

      <Expander Header="Licences" HorizontalAlignment="Stretch">
        <StackPanel Spacing="6">
          <TextBlock Classes="body" Text="Avalonia UI, CommunityToolkit.Mvvm, .NET — MIT licence" />
          <TextBlock Classes="body" Text="Inter typeface — SIL Open Font Licence 1.1" />
          <TextBlock Classes="body" Text="NVIDIA NVAPI headers — MIT licence. The NVIDIA driver itself is not included." />
          <TextBlock Classes="body" Text="Sysinternals tools are not included (Microsoft's licence doesn't allow it)." />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
